# === TERRAFORM ===
# Local .terraform directories (anywhere in repo)
**/.terraform/*
.terraform/

# Terraform lock file
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable overrides
*.tfvars
*.tfvars.json

# Sensitive or local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc


# === LINUX & EDITOR FILES ===
# System junk
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
*.swp
*.swo
*.bak
*.tmp

# VS Code
.vscode/
.history/

# Logs
*.log
logs/
